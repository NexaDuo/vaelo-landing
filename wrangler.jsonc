// Hotsite vaelo.club on Cloudflare Workers Static Assets (vaelo BACKLOG #23, brief 18 §5.6).
// Zone routes, not custom domains: traffic moves only when the vaelo.club and
// www DNS records are proxied (orange cloud); grey cloud falls back to GitHub Pages.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vaelo-landing",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    // The worker runs first only to send www to the apex.
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "vaelo.club/*", "zone_name": "vaelo.club" },
    { "pattern": "www.vaelo.club/*", "zone_name": "vaelo.club" }
  ]
}
