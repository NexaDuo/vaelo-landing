/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY

# Apple reads this file only as JSON; it has no extension.
/.well-known/apple-app-site-association
  Content-Type: application/json

# Android Credential Manager checks the Passkey RP ID (vaelo.club) against this file (get_login_creds only: it does not make vaelo.club links open the app).
/.well-known/assetlinks.json
  Content-Type: application/json
  Cache-Control: no-cache

/*.woff2
  Cache-Control: public, max-age=604800
/*.png
  Cache-Control: public, max-age=86400
/*.webp
  Cache-Control: public, max-age=86400
/favicon.ico
  Cache-Control: public, max-age=86400
